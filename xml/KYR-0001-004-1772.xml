<lb/><persName ref="cwgk:N00014327">G. D. Calvin</persName>
<lb/><persName ref="cwgk:N00014328">Thomas Earls</persName>
<lb/><persName ref="cwgk:N00003754">R. Stowen</persName>
<lb/><persName ref="cwgk:N00014329">N. S. Dickerson</persName>
